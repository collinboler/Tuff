rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — any signed-in user may read (so friends see
    // avatars); only the owning user may write their own file.
    match /profileImages/{filename} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && filename.matches(request.auth.uid + '.*')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Fallback: signed-in users can read anything else; writes must
    // go through a specific rule above.
    match /{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
  }
}
